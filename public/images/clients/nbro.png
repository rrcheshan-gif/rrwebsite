<td style="width: 100%; box-sizing: border-box; background-color: transparent; text-align: center; display: block; overflow: hidden;" valign="top" align="center"><a href="images/webnews/HSD/Mawathagama/IMG_3127.jpeg" target="_blank" style="text-decoration: none;" rel="noopener"><img src="https://img.pblc.app/i/1260x756x9.coords.DO.2,67x0-97,33x100/fa246/6912dc8ea7babaa6d496c935.jpg" width="630" class="sFW" style="margin: 0 auto; display: block; width: 630px; box-sizing: border-box;" null="" /></a></td>
