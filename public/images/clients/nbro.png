<script>
document.addEventListener('DOMContentLoaded', function () {
  // Only on article id=692 or id=384 (also supports those in the hash)
  function isTargetPage() {
    var u = new URL(location.href);
    var p = u.searchParams;
    if (p.get('option') === 'com_content' && p.get('view') === 'article' &&
       (p.get('id') === '692' || p.get('id') === '384')) return true;
    if (location.hash && /option=com_content.*view=article.*id=(692|384)/.test(location.hash)) return true;
    return false;
  }
  if (!isTargetPage()) return;

  var aside = document.getElementById('asidenew');
  if (!aside) return;

  // Find the row that holds both columns
  var row = aside.closest('.row');
  if (!row) return;

  // Remove the aside column completely
  var asideCol = aside.closest('[class*="col-"]') || aside;
  if (asideCol && asideCol.parentNode) {
    asideCol.parentNode.removeChild(asideCol);
  }

  // Find the surviving content column inside the same row
  var leftCol = row.querySelector(':scope > [class*="col-"]');
  if (!leftCol) return;

  // Remove ALL Bootstrap grid classes (xs/sm/md/lg/xl, 1–12, offsets, etc.)
  leftCol.className = leftCol.className
    .split(/\s+/)
    .filter(function(c){
      return !/^col(-(xs|sm|md|lg|xl))?-(\d+|auto)$/.test(c)   // col-*, col-md-8, col-lg-auto
             && !/^col(-(xs|sm|md|lg|xl))?-offset-\d+$/.test(c) // offsets
             && !/^offset-(\d+)$/.test(c);                     // BS5 offset
    })
    .join(' ')
    .trim();

  // Add full-width classes for all breakpoints (BS3/4/5 safe)
  leftCol.classList.add('col-xs-12','col-sm-12','col-md-12','col-lg-12','col-12');

  // Inline fallbacks (in case theme CSS is very opinionated)
  leftCol.style.width = '100%';
  leftCol.style.maxWidth = '100%';
  leftCol.style.flex = '0 0 100%';     // BS4/5 flex grids
  leftCol.style.clear = 'both';        // BS3 floats
});
</script>

<script>
  
  /*<section class="bmrt-article">
<figure class="bmrt-hero" style="--hero: url('images/Coarse-banner.png');"><img src="images/Coarse-banner.png" alt="Coarse aggregate banner" /></figure>
</section>*/
 
document.addEventListener('DOMContentLoaded', function () {
  // Only run on pages that include your article layout
  var article = document.querySelector('section.bmrt-article');
  var hero    = article && article.querySelector('.bmrt-hero');
  if (!article || !hero) return;

  // Hoist the banner above the left+right columns (keep sidebar)
  var row = hero.closest('.row') || document.querySelector('.contentNew .container .row');
  if (row && row.parentNode) {
    var band = document.querySelector('.bmrt-hero-band');
    if (!band) {
      band = document.createElement('section');
      band.className = 'bmrt-hero-band';
      row.parentNode.insertBefore(band, row);
    }
    if (!band.contains(hero)) band.appendChild(hero);
  }

  // Add a body flag so CSS can scope styles & remove top gap
  document.body.classList.add('has-bmrt-hero');
});
</script>





     
     
