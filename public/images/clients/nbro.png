<tr>
<td style="width: 100%; box-sizing: border-box; background-color: transparent; border-radius: 24px 24px 24px 24px; padding: 10px 0 0 0; text-align: center; display: block; overflow: hidden;" valign="top" align="center"><a href="https://adaderanaenglish.s3.amazonaws.com/1759923105-Speaker-of-House-Jagath-Wickramaratne-Sri-Lanka-Ada-Derana-6.jpg" target="_blank" style="text-decoration: none;" rel="noopener"><img src="https://img.pblc.app/i/1160x696x9.coords.DO.0,64x0-99,36x100/f84ad/69008dc3263c5103b0d372b6.jpg" width="580" class="sFW" style="margin: 0 auto; display: block; width: 580px; box-sizing: border-box; border-radius: 23.593220338983052px;" null="" /></a></td>
</tr>
