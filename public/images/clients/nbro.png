<tr style="width: 100%;">
<td style="width: 100%;">
<table align="center" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
<tbody>
<tr>
<td style="width: 100%; box-sizing: border-box; font-weight: bold; display: block; line-height: 1.5; font-size: 2px; text-align: center; font-family: lato,helvetica,arial,sans-serif; color: #4f3a2e; padding: 0 0 10px 0; background-color: null;" valign="top" align="center">
<div style="width: 100%; font-weight: bold; display: block; line-height: 1.5; font-size: 2px; text-align: center; font-family: lato,helvetica,arial,sans-serif; color: #4f3a2e; background-color: transparent;"><span style="font-size: 22px;">NBRO to Lead Nation-Wide Safety Drive with Cabinet Approval for Three Landmark Projects</span></div>
</td>
</tr>
